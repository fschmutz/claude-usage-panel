{
  "cases": [
    {
      "name": "empty store",
      "files": [],
      "expect": {
        "count": 0,
        "autos": 0,
        "newest": null
      }
    },
    {
      "name": "newest by savedAt, autos counted, broken files skipped",
      "files": [
        {
          "label": "before-reboot",
          "data": {
            "version": 1,
            "savedAt": 1790170000000,
            "sessions": [
              {
                "name": "API",
                "cwd": "/r/API",
                "session_id": "API-id"
              },
              {
                "name": "WEB",
                "cwd": "/r/WEB",
                "session_id": "WEB-id"
              }
            ]
          }
        },
        {
          "label": "auto-2026-09-23_220001",
          "data": {
            "version": 1,
            "savedAt": 1790193601000,
            "sessions": [
              {
                "name": "HOME",
                "cwd": "/r/HOME",
                "session_id": "HOME-id"
              }
            ]
          }
        },
        {
          "label": "auto-2026-09-23_193010",
          "data": {
            "version": 1,
            "savedAt": 1790184610000,
            "sessions": [
              {
                "name": "API",
                "cwd": "/r/API",
                "session_id": "API-id"
              }
            ]
          }
        },
        {
          "label": "broken",
          "data": null
        },
        {
          "label": "no-sessions",
          "data": {
            "version": 1,
            "savedAt": 1799999999999
          }
        }
      ],
      "expect": {
        "count": 3,
        "autos": 2,
        "newest": {
          "label": "auto-2026-09-23_220001",
          "savedAt": 1790193601000,
          "names": [
            "HOME"
          ]
        }
      }
    },
    {
      "name": "same savedAt: reverse code-point label order (B before a is NOT locale order)",
      "files": [
        {
          "label": "a",
          "data": {
            "savedAt": 5,
            "sessions": [
              {
                "name": "X",
                "cwd": "/r/X",
                "session_id": "X-id"
              }
            ]
          }
        },
        {
          "label": "B",
          "data": {
            "savedAt": 5,
            "sessions": [
              {
                "name": "Y",
                "cwd": "/r/Y",
                "session_id": "Y-id"
              }
            ]
          }
        }
      ],
      "expect": {
        "count": 2,
        "autos": 0,
        "newest": {
          "label": "a",
          "savedAt": 5,
          "names": [
            "X"
          ]
        }
      }
    },
    {
      "name": "missing savedAt sorts last",
      "files": [
        {
          "label": "old",
          "data": {
            "sessions": [
              {
                "name": "X",
                "cwd": "/r/X",
                "session_id": "X-id"
              }
            ]
          }
        },
        {
          "label": "new",
          "data": {
            "savedAt": 1,
            "sessions": [
              {
                "name": "Y",
                "cwd": "/r/Y",
                "session_id": "Y-id"
              }
            ]
          }
        }
      ],
      "expect": {
        "count": 2,
        "autos": 0,
        "newest": {
          "label": "new",
          "savedAt": 1,
          "names": [
            "Y"
          ]
        }
      }
    }
  ],
  "pause": [
    {
      "name": "no pause file",
      "data": null,
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": false,
        "since": null,
        "expired": false
      }
    },
    {
      "name": "paused this boot",
      "data": {
        "version": 1,
        "at": 1795165000000,
        "bootAt": 1795163219516
      },
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": true,
        "since": 1795165000000,
        "expired": false
      }
    },
    {
      "name": "clock adjusted since, within the tolerance",
      "data": {
        "version": 1,
        "at": 1795165000000,
        "bootAt": 1795163160000
      },
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": true,
        "since": 1795165000000,
        "expired": false
      }
    },
    {
      "name": "exactly the tolerance is still this boot",
      "data": {
        "version": 1,
        "at": 1795165000000,
        "bootAt": 1795163279000
      },
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": true,
        "since": 1795165000000,
        "expired": false
      }
    },
    {
      "name": "one ms past the tolerance is another boot",
      "data": {
        "version": 1,
        "at": 1795165000000,
        "bootAt": 1795163279001
      },
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": false,
        "since": null,
        "expired": true
      }
    },
    {
      "name": "paused before a reboot",
      "data": {
        "version": 1,
        "at": 1795080000000,
        "bootAt": 1795070000000
      },
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": false,
        "since": null,
        "expired": true
      }
    },
    {
      "name": "boot time unknown: not paused, not removed",
      "data": {
        "version": 1,
        "at": 1795165000000,
        "bootAt": 1795163219000
      },
      "bootAtMs": null,
      "expect": {
        "paused": false,
        "since": null,
        "expired": false
      }
    },
    {
      "name": "at is a string",
      "data": {
        "version": 1,
        "at": "1795165000000",
        "bootAt": 1795163219000
      },
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": false,
        "since": null,
        "expired": false
      }
    },
    {
      "name": "bootAt is a boolean",
      "data": {
        "version": 1,
        "at": 1795165000000,
        "bootAt": true
      },
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": false,
        "since": null,
        "expired": false
      }
    },
    {
      "name": "an array is not a pause",
      "data": [
        1795165000000,
        1795163219000
      ],
      "bootAtMs": 1795163219000,
      "expect": {
        "paused": false,
        "since": null,
        "expired": false
      }
    }
  ]
}
