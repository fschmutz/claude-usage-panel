{
  "_comment": "Account health and the inline notices, pinned across lib/pure/notices.js (GNOME, and the CLI + MCP, which import it) and ClaudeUsageCore/Notices.swift (macOS); `outcomes`, `outcomeTtlMs`, `rotation` and `rotationMin` are GNOME + Swift only (no Node client draws a button), and so is `needsAttention`. `health` folds the stored login's own dates together with whatever the last usage fetch said, so a login whose dates look fine but whose STORED token the endpoint (or the refresh exchange) turned down is reported as refresh-failed rather than drawn as current. `live: true` marks a row whose token was the live login's: a refusal of that one is Claude Code's to refresh and reads unreachable, never refresh-failed. Only refresh_failed (a 400/401 from the token endpoint, or a 200 without an access token), a stored token's auth_expired, and login_expired call for a new sign-in; a 429/5xx (transient), any other status (http_error), no network, an unparsable body and an unreadable live login (no_token) are unreachable. `notices` says WHICH inline rows appear, in what order, how loud, and what the one repair button does - the sentences and button labels are per port, because they are translated, and are not asserted here.",
  "now": 1789300000000,
  "outcomeTtlMs": 6000,
  "rotationMin": 2,
  "health": [
    {
      "name": "a live token the endpoint refused is Claude Code's to refresh, not the profile's",
      "tokenState": "valid", "errorCode": "auth_expired", "live": true,
      "expected": "unreachable", "needsAttention": false
    },
    {
      "name": "the live login could not be read: it is never refreshed in its place",
      "tokenState": "stale", "errorCode": "no_token",
      "expected": "unreachable", "needsAttention": false
    },
    {
      "name": "the token endpoint answered 503: try again, the login is fine",
      "tokenState": "stale", "errorCode": "transient",
      "expected": "unreachable", "needsAttention": false
    },
    {
      "name": "the token endpoint answered something unexpected (403, 404)",
      "tokenState": "stale", "errorCode": "http_error",
      "expected": "unreachable", "needsAttention": false
    },
    {
      "name": "a 403 (forbidden) is a token not allowed this endpoint: no sign-in cures it",
      "tokenState": "valid", "errorCode": "forbidden",
      "expected": "unreachable", "needsAttention": false
    },
    {
      "name": "a fresh stored token, fetch worked",
      "tokenState": "valid", "errorCode": null,
      "expected": "valid", "needsAttention": false
    },
    {
      "name": "about to expire - the refresh token handles it on next use",
      "tokenState": "stale", "errorCode": null,
      "expected": "stale", "needsAttention": false
    },
    {
      "name": "no refresh token left: only a new login helps",
      "tokenState": "expired", "errorCode": null,
      "expected": "expired", "needsAttention": true
    },
    {
      "name": "the store refused before the fetch, which is the same answer",
      "tokenState": "valid", "errorCode": "login_expired",
      "expected": "expired", "needsAttention": true
    },
    {
      "name": "the refresh exchange was tried and refused",
      "tokenState": "stale", "errorCode": "refresh_failed",
      "expected": "refresh-failed", "needsAttention": true
    },
    {
      "name": "the dates say valid but the endpoint refused the token",
      "tokenState": "valid", "errorCode": "auth_expired",
      "expected": "refresh-failed", "needsAttention": true
    },
    {
      "name": "a refusal outranks an expiry: it is the more specific thing to fix",
      "tokenState": "expired", "errorCode": "refresh_failed",
      "expected": "refresh-failed", "needsAttention": true
    },
    {
      "name": "a 429 says nothing about the login",
      "tokenState": "valid", "errorCode": "transient",
      "expected": "unreachable", "needsAttention": false
    },
    {
      "name": "so does no network",
      "tokenState": "stale", "errorCode": "network_error",
      "expected": "unreachable", "needsAttention": false
    },
    {
      "name": "nor does a body we could not parse",
      "tokenState": "valid", "errorCode": "parse_error",
      "expected": "unreachable", "needsAttention": false
    }
  ],
  "notices": [
    {
      "name": "everything healthy and saved: nothing to say",
      "state": {
        "rows": [
          {"name": "PERSO", "health": "valid"},
          {"name": "PRO", "health": "stale"}
        ],
        "liveEmail": "pro@example.com", "activeName": "PRO", "pending": null, "torn": false
      },
      "expected": []
    },
    {
      "name": "signed in but never saved",
      "state": {
        "rows": [{"name": "PRO", "health": "valid"}],
        "liveEmail": "someone@example.com", "activeName": null, "pending": null, "torn": false
      },
      "expected": [
        {
          "id": "unsaved-login", "kind": "unsaved-login", "severity": "warning",
          "action": "save", "arg": "someone@example.com"
        }
      ]
    },
    {
      "name": "an unsaved login with no email at all cannot be named, so it says nothing",
      "state": {
        "rows": [], "liveEmail": null, "activeName": null, "pending": null, "torn": false
      },
      "expected": []
    },
    {
      "name": "an incomplete switch is the loudest thing on the list",
      "state": {
        "rows": [{"name": "PERSO", "health": "expired"}],
        "liveEmail": "pro@example.com", "activeName": "PRO",
        "pending": {"from": "PRO", "to": "PERSO"}, "torn": false
      },
      "expected": [
        {
          "id": "pending-switch", "kind": "pending-switch", "severity": "critical",
          "action": "finish-switch", "arg": "PERSO"
        },
        {
          "id": "login-expired:PERSO", "kind": "login-expired", "severity": "critical",
          "action": "relogin", "arg": "PERSO"
        }
      ]
    },
    {
      "name": "a torn login is repaired by reinstalling the profile it says it is",
      "state": {
        "rows": [{"name": "PRO", "health": "valid"}],
        "liveEmail": "pro@example.com", "activeName": "PRO", "pending": null, "torn": true
      },
      "expected": [
        {
          "id": "torn-login", "kind": "torn-login", "severity": "warning",
          "action": "repair", "arg": "PRO"
        }
      ]
    },
    {
      "name": "one row per unhappy account, in store order, and healthy rows stay quiet",
      "state": {
        "rows": [
          {"name": "A", "health": "refresh-failed"},
          {"name": "B", "health": "valid"},
          {"name": "C", "health": "unreachable"},
          {"name": "D", "health": "expired"}
        ],
        "liveEmail": "b@example.com", "activeName": "B", "pending": null, "torn": false
      },
      "expected": [
        {
          "id": "refresh-failed:A", "kind": "refresh-failed", "severity": "critical",
          "action": "relogin", "arg": "A"
        },
        {
          "id": "unreachable:C", "kind": "unreachable", "severity": "warning",
          "action": "retry", "arg": "C"
        },
        {
          "id": "login-expired:D", "kind": "login-expired", "severity": "critical",
          "action": "relogin", "arg": "D"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "name": "just happened",
      "outcome": {"control": "switch:PRO", "ok": true, "text": "Now on PRO", "atMs": 1789300000000},
      "nowMs": 1789300000000, "expected": true
    },
    {
      "name": "a second later, still there",
      "outcome": {"control": "save", "ok": true, "text": "Saved", "atMs": 1789300000000},
      "nowMs": 1789300001000, "expected": true
    },
    {
      "name": "one millisecond short of the TTL",
      "outcome": {"control": "save", "ok": true, "text": "Saved", "atMs": 1789300000000},
      "nowMs": 1789300005999, "expected": true
    },
    {
      "name": "exactly at the TTL it is gone",
      "outcome": {"control": "save", "ok": true, "text": "Saved", "atMs": 1789300000000},
      "nowMs": 1789300006000, "expected": false
    },
    {
      "name": "an outcome with nothing to say never shows",
      "outcome": {"control": "save", "ok": true, "text": "", "atMs": 1789300000000},
      "nowMs": 1789300000000, "expected": false
    },
    {
      "name": "a clock that went backwards does not resurrect one",
      "outcome": {"control": "save", "ok": false, "text": "nope", "atMs": 1789300000000},
      "nowMs": 1789299000000, "expected": false
    }
  ],
  "rotation": [
    {
      "name": "walks the list in order",
      "names": ["PRO", "PERSO", "WORK"], "active": "PERSO", "expected": "PRO"
    },
    {
      "name": "and wraps at the end",
      "names": ["PRO", "PERSO", "WORK"], "active": "WORK", "expected": "PERSO"
    },
    {
      "name": "order is code points, like every other list in this repo",
      "names": ["admin", "PRO", "PERSO"], "active": "PRO", "expected": "admin"
    },
    {
      "name": "a live login that is not one of the saved ones starts at the top",
      "names": ["PRO", "PERSO"], "active": null, "expected": "PERSO"
    },
    {
      "name": "an unknown active name starts at the top too",
      "names": ["PRO", "PERSO"], "active": "GONE", "expected": "PERSO"
    },
    {
      "name": "one saved login is not a rotation",
      "names": ["PRO"], "active": "PRO", "expected": null
    },
    {
      "name": "and neither is none",
      "names": [], "active": null, "expected": null
    }
  ]
}
