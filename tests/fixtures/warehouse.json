      "expected": {
        "thisWeekPeak": 12,
        "lastWeekPeak": 30,
        "deltaPoints": -18
      }
    },
    {
      "name": "an unknown key has nothing to report",
      "key": "weekly_oauth_apps",
      "expected": null
    },
    {
      "name": "an account sees only its own rows - the other login's 100% week is not its peak",
      "key": "weekly_all",
      "account": "u-fsc",
      "expected": {
        "thisWeekPeak": 10,
        "lastWeekPeak": 57,
        "deltaPoints": -47
      }
    },
    {
      "name": "a scoped limit the account never used peaks at what it recorded, not at the other login's",
      "key": "weekly_scoped:Fable",
