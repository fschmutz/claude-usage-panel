  "tokenStateStrict": {
    "_comment": "Fields of the wrong JSON type count as absent in every port: a string or boolean `exp` is no expiry (stale, never valid), and a `last_refresh` that is not an RFC 3339 date-time is no date (JS Date.parse would otherwise accept forms Swift never reads).",
    "cases": [
      {
        "name": "a numeric exp far enough ahead is valid",
        "auth": {
          "tokens": {
            "access_token": "eyJhbGciOiJSUzI1NiJ9.eyJleHAiOjE3ODkzMTAwMDB9.sig",
            "refresh_token": "rt"
          }
        },
        "expected": "valid"
      },
      {
        "name": "a string exp is no expiry",
        "auth": {
          "tokens": {
            "access_token": "eyJhbGciOiJSUzI1NiJ9.eyJleHAiOiIxNzg5MzEwMDAwIn0.sig",
            "refresh_token": "rt"
          }
        },
        "expected": "stale"
      },
      {
        "name": "a boolean exp is no expiry",
        "auth": {
          "tokens": {
            "access_token": "eyJhbGciOiJSUzI1NiJ9.eyJleHAiOnRydWV9.sig",
            "refresh_token": "rt"
          }
        },
        "expected": "stale"
