{
  "about": "Where node / claude are searched under a scheduler's minimal PATH. scripts/lib.sh scheduler_bin_dirs (session-ping's claude, auto-update's node) and claude-code/tools.js schedulerDirs must print exactly `expect` for each layout; `node` is the dir scheduler_bin_dir_for node picks. `~` is the sandbox HOME; `nodes` are the dirs holding an executable node. System dirs are sandboxed through CUP_TEST_SYSTEM_BINS.",
  "system": "~/sys/homebrew:~/sys/local",
  "fixed": ["~/.local/bin", "~/.claude/local", "~/.volta/bin", "~/.local/share/fnm/aliases/default/bin", "~/.asdf/shims", "~/.nvm/current/bin", "~/sys/homebrew", "~/sys/local"],
  "cases": [
    {"name": "nothing installed", "env": {}, "nodes": [], "extra": [], "node": null},
    {"name": "volta", "env": {}, "nodes": ["~/.volta/bin"], "extra": [], "node": "~/.volta/bin"},
    {"name": "volta under VOLTA_HOME", "env": {"VOLTA_HOME": "~/v"}, "nodes": ["~/v/bin"], "extra": [], "node": "~/v/bin",
      "fixed": ["~/.local/bin", "~/.claude/local", "~/v/bin", "~/.local/share/fnm/aliases/default/bin", "~/.asdf/shims", "~/.nvm/current/bin", "~/sys/homebrew", "~/sys/local"]},
    {"name": "fnm default alias beats its versions", "env": {},
      "nodes": ["~/.local/share/fnm/aliases/default/bin", "~/.local/share/fnm/node-versions/v20.1.0/installation/bin", "~/.local/share/fnm/node-versions/v22.3.0/installation/bin"],
      "extra": ["~/.local/share/fnm/node-versions/v22.3.0/installation/bin", "~/.local/share/fnm/node-versions/v20.1.0/installation/bin"],
      "node": "~/.local/share/fnm/aliases/default/bin"},
    {"name": "fnm versions only, under FNM_DIR", "env": {"FNM_DIR": "~/fnm"},
      "nodes": ["~/fnm/node-versions/v9.0.0/installation/bin", "~/fnm/node-versions/v10.2.0/installation/bin"],
      "extra": ["~/fnm/node-versions/v10.2.0/installation/bin", "~/fnm/node-versions/v9.0.0/installation/bin"],
      "node": "~/fnm/node-versions/v10.2.0/installation/bin",
      "fixed": ["~/.local/bin", "~/.claude/local", "~/.volta/bin", "~/fnm/aliases/default/bin", "~/.asdf/shims", "~/.nvm/current/bin", "~/sys/homebrew", "~/sys/local"]},
    {"name": "asdf shims beat its installs", "env": {},
      "nodes": ["~/.asdf/shims", "~/.asdf/installs/nodejs/18.20.4/bin", "~/.asdf/installs/nodejs/22.9.0/bin"],
      "extra": ["~/.asdf/installs/nodejs/22.9.0/bin", "~/.asdf/installs/nodejs/18.20.4/bin"],
      "node": "~/.asdf/shims"},
    {"name": "asdf installs only, under ASDF_DATA_DIR", "env": {"ASDF_DATA_DIR": "~/asdf"},
      "nodes": ["~/asdf/installs/nodejs/18.20.4/bin", "~/asdf/installs/nodejs/22.9.0/bin"],
      "extra": ["~/asdf/installs/nodejs/22.9.0/bin", "~/asdf/installs/nodejs/18.20.4/bin"],
      "node": "~/asdf/installs/nodejs/22.9.0/bin",
      "fixed": ["~/.local/bin", "~/.claude/local", "~/.volta/bin", "~/.local/share/fnm/aliases/default/bin", "~/asdf/shims", "~/.nvm/current/bin", "~/sys/homebrew", "~/sys/local"]},
    {"name": "nvm versions, numeric not lexical order", "env": {},
      "nodes": ["~/.nvm/versions/node/v9.11.2/bin", "~/.nvm/versions/node/v10.0.0/bin", "~/.nvm/versions/node/v22.9.0/bin"],
      "extra": ["~/.nvm/versions/node/v22.9.0/bin", "~/.nvm/versions/node/v10.0.0/bin", "~/.nvm/versions/node/v9.11.2/bin"],
      "node": "~/.nvm/versions/node/v22.9.0/bin"},
    {"name": "nvm current link beats its versions", "env": {"NVM_DIR": "~/nvm"},
      "nodes": ["~/nvm/current/bin", "~/nvm/versions/node/v22.9.0/bin"],
      "extra": ["~/nvm/versions/node/v22.9.0/bin"],
      "node": "~/nvm/current/bin",
      "fixed": ["~/.local/bin", "~/.claude/local", "~/.volta/bin", "~/.local/share/fnm/aliases/default/bin", "~/.asdf/shims", "~/nvm/current/bin", "~/sys/homebrew", "~/sys/local"]},
    {"name": "a system node beats a per-version guess", "env": {},
      "nodes": ["~/sys/local", "~/.nvm/versions/node/v22.9.0/bin"],
      "extra": ["~/.nvm/versions/node/v22.9.0/bin"],
      "node": "~/sys/local"},
    {"name": "every manager at once, in manager order", "env": {},
      "nodes": ["~/.local/share/fnm/node-versions/v20.1.0/installation/bin", "~/.asdf/installs/nodejs/22.9.0/bin", "~/.nvm/versions/node/v24.0.0/bin"],
      "extra": ["~/.local/share/fnm/node-versions/v20.1.0/installation/bin", "~/.asdf/installs/nodejs/22.9.0/bin", "~/.nvm/versions/node/v24.0.0/bin"],
      "node": "~/.local/share/fnm/node-versions/v20.1.0/installation/bin"},
    {"name": "a user bin beats every manager", "env": {},
      "nodes": ["~/.local/bin", "~/.volta/bin"], "extra": [], "node": "~/.local/bin"}
  ]
}
