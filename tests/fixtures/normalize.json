{
  "_comment": "Shared normalization contract. Loaded by tests/parity.test.js (lib/pure.js + claude-code/normalize.js) AND macos/Tests/ClaudeUsageCoreTests (Swift). Each case: `input` is a raw usage payload; `expected` is the presentation-agnostic core every port must produce - same kinds, in KIND_ORDER, with identical group, scoped, percent (clamped/rounded), severity, resets_at, and active. Labels are intentionally per-port and NOT asserted here.",
  "cases": [
    {
      "name": "modern limits[] - sorts to KIND_ORDER, clamps, defaults severity/active",
      "input": {
        "limits": [
          {
            "kind": "weekly_scoped", "percent": 100, "severity": "critical",
            "resets_at": "2026-07-07T06:00:00Z", "is_active": true,
            "scope": {"model": {"display_name": "Fable"}}
          },
          {"kind": "session", "percent": 42.6, "severity": "warning", "is_active": true},
          {"kind": "weekly_all", "percent": 72},
          {"kind": "weekly_oauth_apps", "percent": 150, "severity": "normal", "is_active": false}
        ]
      },
      "expected": [
        {"kind": "session", "group": "session", "scoped": false, "percent": 43, "severity": "warning", "resetsAt": null, "active": true},
        {"kind": "weekly_all", "group": "weekly", "scoped": false, "percent": 72, "severity": "normal", "resetsAt": null, "active": false},
        {"kind": "weekly_scoped", "group": "weekly", "scoped": true, "percent": 100, "severity": "critical", "resetsAt": "2026-07-07T06:00:00Z", "active": true},
        {"kind": "weekly_oauth_apps", "group": "weekly", "scoped": false, "percent": 100, "severity": "normal", "resetsAt": null, "active": false}
      ]
    },
    {
      "name": "live payload 2026-07-26 - Fable is a sub-cap of the weekly pool, inherits its reset",
      "input": {
        "limits": [
          {
            "kind": "session", "group": "session", "percent": 5, "severity": "normal",
            "resets_at": "2026-07-26T15:50:00Z", "scope": null, "is_active": false
          },
          {
            "kind": "weekly_all", "group": "weekly", "percent": 28, "severity": "normal",
            "resets_at": "2026-07-28T06:00:00Z", "scope": null, "is_active": true
          },
          {
            "kind": "weekly_scoped", "group": "weekly", "percent": 0, "severity": "normal",
            "resets_at": null, "is_active": false,
            "scope": {"model": {"id": null, "display_name": "Fable"}, "surface": null}
          }
        ]
      },
      "expected": [
        {"kind": "session", "group": "session", "scoped": false, "percent": 5, "severity": "normal", "resetsAt": "2026-07-26T15:50:00Z", "active": false},
        {"kind": "weekly_all", "group": "weekly", "scoped": false, "percent": 28, "severity": "normal", "resetsAt": "2026-07-28T06:00:00Z", "active": true},
        {"kind": "weekly_scoped", "group": "weekly", "scoped": true, "percent": 0, "severity": "normal", "resetsAt": "2026-07-28T06:00:00Z", "active": false}
      ]
    },
    {
      "name": "a scoped limit only inherits a reset from its own pool",
      "input": {
        "limits": [
          {
            "kind": "session", "group": "session", "percent": 12, "severity": "normal",
            "resets_at": "2026-07-26T15:50:00Z", "is_active": true
          },
          {
            "kind": "weekly_scoped", "group": "weekly", "percent": 0, "severity": "normal",
            "resets_at": null, "is_active": false,
            "scope": {"model": {"display_name": "Fable"}}
          }
        ]
      },
      "expected": [
        {"kind": "session", "group": "session", "scoped": false, "percent": 12, "severity": "normal", "resetsAt": "2026-07-26T15:50:00Z", "active": true},
        {"kind": "weekly_scoped", "group": "weekly", "scoped": true, "percent": 0, "severity": "normal", "resetsAt": null, "active": false}
      ]
    },
    {
      "name": "legacy five_hour / seven_day fallback",
      "input": {
        "five_hour": {"utilization": 10, "resets_at": "2026-07-01T03:00:00Z"},
        "seven_day": {"utilization": 55}
      },
      "expected": [
        {"kind": "session", "group": "session", "scoped": false, "percent": 10, "severity": "normal", "resetsAt": "2026-07-01T03:00:00Z", "active": true},
        {"kind": "weekly_all", "group": "weekly", "scoped": false, "percent": 55, "severity": "normal", "resetsAt": null, "active": false}
      ]
    },
    {
      "name": "negative percent clamps to 0",
      "input": {"limits": [{"kind": "session", "percent": -5, "severity": "normal", "is_active": true}]},
      "expected": [
        {"kind": "session", "group": "session", "scoped": false, "percent": 0, "severity": "normal", "resetsAt": null, "active": true}
      ]
    },
    {
      "name": "empty payload → no cards",
      "input": {},
      "expected": []
    },
    {
      "name": "empty limits[] → no cards",
      "input": {"limits": []},
      "expected": []
    }
  ]
}
