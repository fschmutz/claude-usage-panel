#: prefs.js:490
#, javascript-format
msgid "Paused: %s"
msgstr "In pausa: %s"

#: prefs.js:492
msgid ""
"The daily check will not touch this checkout until that is resolved. It only "
"ever fast-forwards a clean checkout."
msgstr ""
"Il controllo giornaliero non toccherà questo checkout finché non è risolto. "
"Fa solo fast-forward su un checkout pulito."

#: prefs.js:497
#, javascript-format
msgid "Update available: %s → %s"
msgstr "Aggiornamento disponibile: %s → %s"

#: prefs.js:498 prefs.js:502 prefs.js:509
#, javascript-format
