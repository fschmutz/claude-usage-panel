msgstr "毎日のチェックと、それが実際に動いているか。"

#: prefs.js:436 prefs.js:509
msgid "Checking…"
msgstr "確認中…"

#: prefs.js:440 prefs.js:461 prefs.js:485 prefs.js:495
msgid "Check now"
msgstr "今すぐ確認"

#: prefs.js:459
msgid "Cannot self-update"
msgstr "自己更新できません"

#: prefs.js:460
msgid "No git checkout found for auto-update.sh."
msgstr "auto-update.sh の git チェックアウトが見つかりません。"

#: prefs.js:468
msgid "Could not read the update status"
msgstr "更新状態を読み取れませんでした"

#: prefs.js:476
#, javascript-format
msgid "Installed %s, checkout %s"
msgstr "インストール済み %s、チェックアウト %s"

#: prefs.js:477
