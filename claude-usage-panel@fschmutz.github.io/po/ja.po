#: prefs.js:486
msgid "Switch accounts automatically"
msgstr "アカウントを自動で切り替える"

#: prefs.js:487
msgid ""
"When the active account reaches the threshold, move to the saved account "
"with the most headroom"
msgstr ""
"アクティブなアカウントがしきい値に達したら、最も余裕のある保存済みアカウント"
"へ移る"

#: prefs.js:492
msgid "Auto-switch threshold"
msgstr "自動切替のしきい値"

#: prefs.js:493
msgid "Worst limit percentage that counts as full"
msgstr "満杯とみなす最悪の上限の割合"

#: prefs.js:501
msgid "Show the account name in the top bar"
msgstr "トップバーにアカウント名を表示"

#: prefs.js:502
msgid "\"PRO · Session 42%\" instead of \"Session 42%\""
msgstr "「Session 42%」の代わりに「PRO · Session 42%」"

