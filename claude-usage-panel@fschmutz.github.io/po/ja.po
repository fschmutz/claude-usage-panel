msgstr "Claude Code のログインが見つかりません"

#: prefs.js:606
msgid "login expired - sign in and save it again"
msgstr "ログイン期限切れ - 再度サインインして保存し直してください"

#: prefs.js:613
msgid "Forget this saved login"
msgstr "この保存済みログインを削除"

#: prefs.js:633
msgid "Names use letters, digits, . _ - only (up to 32 characters)"
msgstr "名前に使えるのは英数字と . _ - のみ(最大 32 文字)"

