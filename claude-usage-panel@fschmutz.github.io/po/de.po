#: prefs/general.js:34
msgid "Which limit to display in the panel"
msgstr "Welches Limit im Panel angezeigt wird"

#: prefs/general.js:35
msgid "Worst limit"
msgstr "Schlechtestes Limit"

#: prefs/general.js:35
msgid "Current session"
msgstr "Aktuelle Sitzung"

#: prefs/general.js:43
msgid "Limit-crossing alerts"
msgstr "Warnungen beim Überschreiten"

#: prefs/general.js:44
msgid "Notify when a limit reaches 90% or 100%"
msgstr "Benachrichtigen, wenn ein Limit 90% oder 100% erreicht"

#: prefs/general.js:53
msgid "Run on limit crossing or reset"
msgstr "Bei Überschreitung oder Zurücksetzen ausführen"

#: prefs/general.js:62
