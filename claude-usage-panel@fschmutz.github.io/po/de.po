msgstr "Jetzt aktualisieren"

#: prefs.js:410
#, javascript-format
msgid "Paused: %s"
msgstr "Pausiert: %s"

#: prefs.js:412
msgid ""
"The daily check will not touch this checkout until that is resolved. It only "
"ever fast-forwards a clean checkout."
msgstr ""
"Die tägliche Prüfung rührt dieses Checkout nicht an, solange das nicht "
"behoben ist. Sie macht nur Fast-Forwards auf einem sauberen Checkout."

#: prefs.js:417
#, javascript-format
msgid "Update available: %s → %s"
msgstr "Update verfügbar: %s → %s"

