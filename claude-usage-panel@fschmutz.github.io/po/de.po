msgid ""
"List the sessions that spent the most tokens today, biggest first, and "
"resume one in a terminal with a click. Read from the local transcripts in "
"$CLAUDE_CONFIG_DIR/projects (~/.claude/projects by default)."
msgstr ""
"Listet die Sitzungen auf, die heute die meisten Tokens verbraucht haben, "
"größte zuerst, und setzt eine per Klick im Terminal fort. Aus den lokalen "
"Transkripten in $CLAUDE_CONFIG_DIR/projects (standardmäßig ~/.claude/"
"projects)."

#: prefs/sessions.js:20
msgid "Show today’s sessions"
msgstr "Heutige Sitzungen anzeigen"

