msgid "Add a ping"
msgstr "Añadir un ping"

#: prefs.js:319
msgid "Suggest times"
msgstr "Sugerir horas"

#: prefs.js:335
#, javascript-format
msgid "%d%% of %s-%s covered"
msgstr "%d%% de %s-%s cubierto"

#: prefs.js:337
msgid "no valid times yet"
