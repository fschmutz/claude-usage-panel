msgstr ""
"在解决之前，每日检查不会改动此检出目录。它只会对干净的检出执行 fast-forward。"

#: prefs.js:487
#, javascript-format
msgid "Update available: %s → %s"
msgstr "有可用更新：%s → %s"

#: prefs.js:488 prefs.js:494
#, javascript-format
msgid "Last checked %s"
msgstr "上次检查 %s"

#: prefs.js:492
